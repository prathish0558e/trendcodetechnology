[TEMPLATE]
# Copy this file to server/.env and fill in real values.
#
# --- Vercel deployment ---
# On Vercel, add ALL of these as Environment Variables in the Vercel project
# dashboard (Settings → Environment Variables) — server/.env is NOT deployed.
# The API runs as a serverless function (api/index.js). Values already set in
# the Vercel environment always win: dotenv never overrides them.
PUBLIC_SITE_URL=https://tctechs.in

# --- Database (REQUIRED on Vercel — makes the admin panel + login work) ---
# Without this the API falls back to per-instance memory: leads, applications
# and logins vanish on every cold start, so the admin page shows 0 items.
# MongoDB Atlas (free tier) → Connect → Drivers → copy the URI, e.g.
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/tct?retryWrites=true&w=majority
MONGODB_URI=
#
# This file is gitignored and scripts/vercel-env-sync.mjs pushes this exact
# value to Vercel, so the real URI lives here and nowhere in git.
# Locally the file store is still used unless USE_MONGODB=1 is set, so test
# rows from "npm run dev" never land in the live database.
USE_MONGODB=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trendcodetechnology2026@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=trendcodetechnology2026@gmail.com

# --- WhatsApp lead alert (free, via CallMeBot) ---
# One-time setup (from the WhatsApp account that should RECEIVE alerts):
#   1. Save this bot number in your contacts: +34 684 783 347
#   2. Send it this exact message: "I allow callmebot to send me messages"
#   3. It replies with your apikey. Put that key below, and your WhatsApp
#      number (country code, no +) in WA_PHONE.
WA_PHONE=919384847922
WA_APIKEY=

# --- Admin panel login (/login -> /admin) ---
ADMIN_USER=admin@trendcode.com
# Store ONLY a bcrypt hash, never the plain password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASS_HASH=$2b$10$replaceWithYourBcryptHash
# Random secret returned to the browser after login (any long random string):
ADMIN_TOKEN=generate-a-long-random-hex-string
