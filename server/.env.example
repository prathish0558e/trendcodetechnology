# Copy this file to server/.env and fill in real values.
#
# --- Vercel deployment ---
# On Vercel, add ALL of these as Environment Variables in the Vercel project
# dashboard (Settings → Environment Variables) — server/.env is NOT deployed.
# The API runs as a serverless function (api/index.js). Values already set in
# the Vercel environment always win: dotenv never overrides them.
PUBLIC_SITE_URL=https://tctechs.in

# --- Database (REQUIRED on Vercel — makes the admin panel + login work) ---
# Without this the API falls back to per-instance memory: leads, applications
# and logins vanish on every cold start, so the admin page shows 0 items.
# MongoDB Atlas (free tier) → Connect → Drivers → copy the URI, e.g.
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/tct?retryWrites=true&w=majority
MONGODB_URI=
#
# This file is gitignored and scripts/vercel-env-sync.mjs pushes this exact
# value to Vercel, so the real URI lives here and nowhere in git.
# Locally the file store is still used unless USE_MONGODB=1 is set, so test
# rows from "npm run dev" never land in the live database.
USE_MONGODB=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trendcodetechnology2026@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=trendcodetechnology2026@gmail.com

# --- WhatsApp alerts (official Meta WhatsApp Business Cloud API) ---
# Alerts for new enquiries, job applications and internship applications are
# sent from the TCT business number. One-time setup in developers.facebook.com:
#   1. Create a Meta app (type: Business) and add the "WhatsApp" product.
#   2. Add your business number under WhatsApp > API Setup, then verify it via
#      the SMS/call code — that number is the SENDER of the alerts.
#   3. Copy its "Phone number ID" -> WHATSAPP_PHONE_NUMBER_ID.
#   4. Create a System User (Business settings > Users) with access to the
#      WhatsApp account and generate a permanent token -> WHATSAPP_TOKEN.
# Keep the token on the server only; never in a VITE_ variable.
#
# WHATSAPP_TO receives the alerts (defaults to WA_PHONE). A business may only
# start a free-form chat inside the 24-hour customer service window, so for
# alerts at any hour set a utility template and point WHATSAPP_TEMPLATE at it.
# The live TCT template (WhatsApp Manager > Message templates, category
# Utility, language English (US)) is:
#   name tct_alert_v1
#   body "New enquiry from {{1}}. Please open the TCT admin panel for details."
# Two rules Meta enforces when creating it via the API:
#   * a variable may not sit at the start or end of the body;
#   * a body with a variable must ship an example value, otherwise the template
#     comes back REJECTED with reason INVALID_FORMAT.
# Note: the shared Meta test number (+1 555-629-3298) can only message up to 5
# allow-listed recipients — verify your own business number before relying on
# alerts for a team.
WA_PHONE=919384847922
WHATSAPP_TO=919384847922
WHATSAPP_PHONE_NUMBER_ID=
# WABA id — not used by the server, only by "npm run whatsapp:status" / the tester.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
# Leave empty to send plain text (works only inside the 24h window).
WHATSAPP_TEMPLATE=tct_alert_v1
WHATSAPP_TEMPLATE_LANG=en_US

# --- Legacy fallback: CallMeBot (used only when the Meta vars are empty) ---
#   1. Save this bot number in your contacts: +34 684 783 347
#   2. Send it this exact message: "I allow callmebot to send me messages"
#   3. It replies with your apikey — put that key below.
WA_APIKEY=

# --- Admin panel login (/login -> /admin) ---
ADMIN_USER=admin@trendcode.com
# Local development only: keep this in the ignored server/.env file, never commit it.
ADMIN_PASS=
# Production must use a bcrypt hash, never ADMIN_PASS. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASS_HASH=$2b$10$replaceWithYourBcryptHash
# Random secret returned to the browser after login (any long random string):
ADMIN_TOKEN=generate-a-long-random-hex-string
