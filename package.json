{
  "name": "trend-code-technology",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Trend Code Technology - corporate website (React + Vite + Express)",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build && node scripts/generate-seo.mjs",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "seo:check": "node scripts/seo-check.mjs",
    "whatsapp:status": "node scripts/whatsapp-test.mjs --status",
    "whatsapp:test": "node scripts/whatsapp-test.mjs --send",
    "deploy:vercel": "node scripts/vercel-deploy.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "gsap": "^3.12.5",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@react-three/postprocessing": "^2.16.3",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "postprocessing": "^6.36.4",
    "vite": "^5.4.8"
  }
}
